                    </div>

                    <!-- Decorative Gold Lace Ring -->
                    <div class="relative flex items-center justify-center">
                        <svg class="w-72 h-72 text-[#d4be96] pointer-events-none" viewBox="0 0 300 300" fill="none">
                            <circle cx="150" cy="150" r="136" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 5"/>
                            <circle cx="150" cy="150" r="122" stroke="currentColor" stroke-width="1.5"/>
