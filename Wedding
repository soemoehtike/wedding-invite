                </div>

                <!-- Right Door -->
                <div class="envelope-door-right absolute inset-y-0 right-0 w-1/2 paper-texture border-l border-[#dfd3be] shadow-xl flex items-center justify-start overflow-hidden">
                    <svg class="w-[340px] h-[340px] -ml-[170px] text-[#d6c5a7] opacity-80" viewBox="0 0 200 200" fill="none">
                        <circle cx="100" cy="100" r="92" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4"/>
                        <circle cx="100" cy="100" r="80" stroke="currentColor" stroke-width="1"/>
                        <circle cx="100" cy="100" r="66" stroke="currentColor" stroke-width="1.5"/>
