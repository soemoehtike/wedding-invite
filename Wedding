    <!-- ========================================== -->
    <!-- JAVASCRIPT LOGIC                           -->
    <!-- ========================================== -->
    <script>
        // Convert English numbers to Burmese digits
        const mmDigits = ['၀', '၁', '၂', '၃', '၄', '၅', '၆', '၇', '၈', '၉'];
        function toMM(num) {
            return String(num).replace(/\d/g, d => mmDigits[d]);
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.classList.remove('opacity-0');
            setTimeout(() => toast.classList.add('opacity-0'), 2800);
        }

        // 1. Floating Petals Generator
        function createPetals() {
            const container = document.getElementById('petals-container');
            const colors = ['#e8b4b8', '#f5d6ba', '#e5c27b', '#f2c6c2'];
            for (let i = 0; i < 14; i++) {
                const petal = document.createElement('div');
                petal.className = 'petal';
                petal.style.left = Math.random() * 100 + 'vw';
                petal.style.animationDuration = (8 + Math.random() * 7) + 's';
                petal.style.animationDelay = (Math.random() * 6) + 's';
                const size = 10 + Math.random() * 8;
                const color = colors[i % colors.length];
                petal.innerHTML = `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="${color}"><path d="M12 2C8 6 4 10 4 15a8 8 0 0 0 16 0c0-5-4-9-8-13z"/></svg>`;
                container.appendChild(petal);
            }
        }

        // 2. Web Audio API Gentle Romantic Wedding Melody
        let audioCtx = null;
        let isPlaying = false;
        let melodyInterval = null;

        function toggleMusic() {
            const icon = document.getElementById('music-icon');
            if (!isPlaying) {
                startWeddingMelody();
                isPlaying = true;
                icon.className = 'fa-solid fa-music text-sm animate-pulse';
                showToast('မင်္ဂလာ တေးသံသာ ဖွင့်ထားပါသည်');
            } else {
                stopWeddingMelody();
                isPlaying = false;
                icon.className = 'fa-solid fa-volume-xmark text-sm';
                showToast('တေးသံသာ ပိတ်လိုက်ပါပြီ');
            }
        }

        function startWeddingMelody() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            // Canon in D inspired gentle chime notes (Hz)
            const notes = [587.33, 440.00, 493.88, 369.99, 392.00, 293.66, 392.00, 440.00];
            let step = 0;

            function playNote() {
                if (!isPlaying) return;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(notes[step % notes.length], audioCtx.currentTime);

                gain.gain.setValueAtTime(0.001, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.04, audioCtx.currentTime + 0.15);
                gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 1.4);

                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 1.45);
                step++;
            }

            playNote();
            melodyInterval = setInterval(playNote, 1100);
        }

        function stopWeddingMelody() {
            if (melodyInterval) clearInterval(melodyInterval);
        }

        // 3. Open Wax Seal Envelope
        function openInvitation() {
            const overlay = document.getElementById('envelope-overlay');
            const sealBtn = document.getElementById('wax-seal-btn');
            const mainContent = document.getElementById('main-content');

            sealBtn.classList.add('cracking');

            // Automatically start gentle music on user tap
            if (!isPlaying) {
                toggleMusic();
            }

            setTimeout(() => {
                overlay.classList.add('envelope-opened');
                mainContent.classList.remove('opacity-0');
            }, 350);

            setTimeout(() => {
                overlay.style.display = 'none';
            }, 1500);
        }

        // 4. December 2026 Calendar (Dec 1, 2026 is Tuesday -> 2 leading empty slots)
        // Highlighting BOTH Dec 3 and Dec 4
        function initCalendar() {
            const grid = document.getElementById('calendar-days');
            for (let i = 0; i < 2; i++) {
                grid.appendChild(document.createElement('div'));
            }
            for (let day = 1; day <= 31; day++) {
                const cell = document.createElement('div');
                if (day === 3 || day === 4) {
                    cell.innerHTML = `<span class="inline-flex items-center justify-center w-8 h-8 rounded-full border-2 border-[#f7e3b5] bg-[#c59b47] font-bold text-[#332927] shadow">${toMM(day)}</span>`;
                } else {
                    cell.textContent = toMM(day);
                    cell.className = 'text-[#f2d9b3] py-1';
                }
                grid.appendChild(cell);
            }
        }

        // 5. Live Countdown to December 3, 2026 at 09:00 AM MMT (+06:30)
        function startCountdown() {
            const target = new Date('2026-12-03T09:00:00+06:30').getTime();

            function update() {
                const now = new Date().getTime();
                const diff = target - now;

                if (diff <= 0) {
                    ['cd-days', 'cd-hours', 'cd-mins', 'cd-secs'].forEach(id => {
                        document.getElementById(id).textContent = '၀၀';
                    });
                    return;
                }

                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const secs = Math.floor((diff % (1000 * 60)) / 1000);

                document.getElementById('cd-days').textContent = toMM(String(days).padStart(2, '0'));
                document.getElementById('cd-hours').textContent = toMM(String(hours).padStart(2, '0'));
                document.getElementById('cd-mins').textContent = toMM(String(mins).padStart(2, '0'));
                document.getElementById('cd-secs').textContent = toMM(String(secs).padStart(2, '0'));
            }

            update();
            setInterval(update, 1000);
        }

        // 6. Draw Wave Money Styled QR Code on Canvas
        function drawWaveQRCode() {
            const canvas = document.getElementById('wave-qr-canvas');
            const ctx = canvas.getContext('2d');
            const size = 180;
            const modules = 25;
            const cell = size / modules;

            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, size, size);
            ctx.fillStyle = '#0054a6';

            let seed = 942893588;
            function rand() {
                seed = (seed * 9301 + 49297) % 233280;
                return seed / 233280;
            }

            for (let r = 0; r < modules; r++) {
                for (let c = 0; c < modules; c++) {
                    if ((r < 7 && c < 7) || (r < 7 && c >= modules - 7) || (r >= modules - 7 && c < 7)) continue;
                    if (r >= 9 && r <= 15 && c >= 9 && c <= 15) continue;
                    if (rand() > 0.48) {
                        ctx.fillRect(c * cell, r * cell, cell - 0.5, cell - 0.5);
                    }
                }
            }

            function drawFinder(x, y) {
                ctx.fillStyle = '#0054a6';
                ctx.fillRect(x, y, 7 * cell, 7 * cell);
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(x + cell, y + cell, 5 * cell, 5 * cell);
                ctx.fillStyle = '#0054a6';
                ctx.fillRect(x + 2 * cell, y + 2 * cell, 3 * cell, 3 * cell);
            }

            drawFinder(0, 0);
            drawFinder((modules - 7) * cell, 0);
            drawFinder(0, (modules - 7) * cell);

            // Center Wave Badge
            ctx.fillStyle = '#f7d000';
            ctx.beginPath();
            ctx.roundRect(size / 2 - 24, size / 2 - 14, 48, 28, 7);
            ctx.fill();
            ctx.fillStyle = '#0054a6';
            ctx.font = 'bold 11px sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('Wave', size / 2, size / 2);
        }

        function copyWaveNumber() {
            const temp = document.createElement('textarea');
            temp.value = '09428935889';
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);
            showToast('WavePay နံပါတ် 09428935889 ကို ကူးယူပြီးပါပြီ');
        }

        function downloadWaveQR() {
            const canvas = document.getElementById('wave-qr-canvas');
            const link = document.createElement('a');
            link.download = 'SoeMoeHtike_WavePay_QR.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
            showToast('WavePay QR Code ပုံကို သိမ်းဆည်းပြီးပါပြီ');
        }

        // 7. RSVP & Wishes Guestbook (localStorage)
        const STORAGE_KEY = 'soe_moe_htike_wedding_wishes_v1';
        let guestCount = 2;

        const defaultWishes = [
            {
                name: 'ကိုကျော်ဇင် နှင့် မသူဇာ',
                status: 'တက်ရောက်ပါမည်',
                count: 2,
                wish: 'မောင်စိုးမိုးထိုက် နဲ့ မမြတ်မိုးအိမ် တို့ ရာသက်ပန် အိုအောင်မင်းအောင် ပေါင်းဖက်နိုင်ကြပါစေ 💖'
            },
            {
                name: 'ဒေါ်ခင်မာရီ မိသားစု',
                status: 'တက်ရောက်ပါမည်',
                count: 3,
                wish: 'သာယာချမ်းမြေ့တဲ့ မိသားစုဘဝလေး ပိုင်ဆိုင်နိုင်ပါစေ သားနဲ့သမီးရေ'
            }
        ];

        function getWishes() {
            try {
                const saved = localStorage.getItem(STORAGE_KEY);
                return saved ? JSON.parse(saved) : defaultWishes;
            } catch (e) {
                return defaultWishes;
            }
        }

        function saveWishes(list) {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
            } catch (e) {
                // Ignore storage quota errors
            }
        }

        function changeCount(delta) {
            guestCount = Math.max(1, Math.min(15, guestCount + delta));
            document.getElementById('count-display').textContent = toMM(guestCount);
        }

        function toggleGuestCount(show) {
            document.getElementById('guest-count-box').style.display = show ? 'block' : 'none';
        }

        function handleRsvpSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('guest-name').value.trim();
            const status = document.querySelector('input[name="attendance"]:checked').value;
            const wish = document.getElementById('guest-wish').value.trim();

            if (!name || !wish) return;

            const list = getWishes();
            list.unshift({
                name,
                status,
                count: status === 'တက်ရောက်ပါမည်' ? guestCount : 0,
                wish
            });
            saveWishes(list);
            renderWishes();

            document.getElementById('rsvp-form').reset();
            guestCount = 2;
            document.getElementById('count-display').textContent = toMM(2);
            toggleGuestCount(true);
            showToast('ဆုတောင်းစကား ပေးပို့ပြီးပါပြီ ကျေးဇူးတင်ပါသည်');
        }

        function renderWishes() {
            const list = getWishes();
            const container = document.getElementById('wishes-list');
            document.getElementById('wishes-count').textContent = toMM(list.length);
            container.innerHTML = '';

            list.forEach(item => {
                const badgeClass = item.status === 'တက်ရောက်ပါမည်'
                    ? 'bg-[#e6efe2] text-[#3d5733]'
                    : 'bg-[#f2e6e6] text-[#8f2d36]';
                const countLabel = item.status === 'တက်ရောက်ပါမည်' ? ` (${toMM(item.count)} ဦး)` : '';

                const card = document.createElement('div');
                card.className = 'bg-[#fcf9f2] border border-[#e6d7bd] rounded-2xl p-3 space-y-1';
                card.innerHTML = `
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-bold text-[#332927]">${escapeHtml(item.name)}</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-medium shrink-0 ${badgeClass}">${escapeHtml(item.status)}${countLabel}</span>
                    </div>
                    <p class="text-xs text-[#544643] leading-relaxed">${escapeHtml(item.wish)}</p>
                `;
                container.appendChild(card);
            });
        }

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        // Initialize Everything
        window.onload = function() {
            createPetals();
            initCalendar();
            startCountdown();
            drawWaveQRCode();
            renderWishes();
        };
    </script>
</body>
